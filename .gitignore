# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- never commit real secrets.
# Everything matching .env* is ignored, including .env.production.local
# (the hosted database credentials) and any ad-hoc .env.<whatever> file.
# .env.example is the one exception: it carries names and no values.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma -- generated client is reproducible from the schema
/src/generated

# local database volume
/.docker-data

# sandbox scratch
/.sandbox-tmp

# agent tooling -- vendored from prisma/skills by the Prisma CLI, not product
# code, referenced by nothing here, and reinstalled on demand. Kept on disk,
# out of the repository, so the GitHub tree shows the product.
/.agents
/.claude
/skills-lock.json
