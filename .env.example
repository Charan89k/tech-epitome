# ---------------------------------------------------------------------------
# TECH EPITOME environment
#
# Copy to .env and fill in. Never commit .env.
# Every variable is validated at boot by src/lib/env.ts -- a missing or
# malformed required value fails fast with a readable message instead of
# surfacing as a null-pointer somewhere in a request handler.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Postgres connection string used by the application at runtime. Matches
# docker-compose.yml out of the box.
#
# On a hosted provider this is the POOLED endpoint. Serverless functions open
# one connection per invocation, so a direct connection runs the database out
# of backends long before it runs out of work. For Supabase that is the
# transaction pooler on port 6543.
DATABASE_URL="postgresql://techepitome:techepitome@localhost:5432/techepitome?schema=public"

# Optional. The UNPOOLED endpoint, used only by the Prisma CLI --
# `migrate deploy`, `migrate status`, `studio`. The migration engine holds an
# advisory lock for the length of a migration and runs DDL that outlives a
# single transaction, neither of which survives a transaction pooler. For
# Supabase that is the direct connection on port 5432.
#
# Leave it unset locally: there is only one database, and the Prisma CLI falls
# back to DATABASE_URL. Never referenced by application code, and never
# exposed to the browser.
DIRECT_URL=""

# Both values are secrets. Put the production pair in .env.production.local
# (git-ignored) rather than here, and set them as Environment Variables on the
# host. `npm run db:deploy:prod` then targets that database, and a bare
# `npm run db:migrate` keeps targeting docker-compose.

# Public origin of the app. Used for OAuth callbacks, OG images and sitemaps.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Authentication (Auth.js v5) --------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Optional. Leave both blank to disable the Google button; email/password
# still works. Callback URL: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional, and independent of Google -- either provider can be on with the
# other off. Both blank hides the GitHub button.
# Callback URL: <NEXT_PUBLIC_APP_URL>/api/auth/callback/github
#
# Create at: GitHub -> Settings -> Developer settings -> OAuth Apps.
# "Authorization callback URL" must be the full callback above, exactly.
# Tech Epitome asks only for identity; the provider's default
# `read:user user:email` scope is all it uses, and the access token is
# discarded once the account is linked (see events.linkAccount in
# src/lib/auth/index.ts).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- AI providers -----------------------------------------------------------
# Which provider the tutor and mock interviewer use by default.
# One of: ollama | anthropic
#
# The test suite also accepts "mock", a deterministic double that needs no
# key and no local model. It is rejected in production by src/lib/env.ts and
# refuses to construct there anyway -- do not set it here.
AI_PROVIDER="ollama"

# Anthropic. Required only when AI_PROVIDER=anthropic or a user selects it.
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Ollama. Local, no key needed.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:14b"

# --- Code execution ---------------------------------------------------------
# One of: local | docker | remote
#   local  - subprocess with rlimits. Development only, single trusted user.
#   docker - throwaway container per run. The default for anything shared.
#   remote - Judge0. Use this on serverless hosts (Vercel), which have no
#            container runtime. CODE_EXECUTION_API_URL is the Judge0 base URL:
#              https://ce.judge0.com            public, free, rate limited, no key
#              https://judge0-ce.p.rapidapi.com RapidAPI plan; key = RapidAPI key
#              https://judge0.your-host.example  self-hosted; key = AUTHN token
CODE_EXECUTION_DRIVER="docker"
CODE_EXECUTION_API_URL=""
CODE_EXECUTION_API_KEY=""

# --- Email ------------------------------------------------------------------
# "console" logs the message and delivers nothing; it is refused in production.
# "resend" needs both values below. Tech Epitome sends transactional mail only —
# review reminders — and never sends to a learner who turned them off.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Tech Epitome <noreply@techepitome.local>"

# --- Rate limiting ----------------------------------------------------------
# Set to "true" on any deployment running more than one instance. The default
# store is per-process; with this set and no distributed store installed,
# rate-limited requests are refused rather than silently admitted.
REQUIRE_DISTRIBUTED_RATE_LIMIT="false"
# "postgres" counts in the application database (rate_limit_buckets), shared
# by every instance; set it on serverless deployments such as Vercel. Unset
# keeps the per-process in-memory store.
RATE_LIMIT_STORE=""

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for POST /api/cron/notifications, which sends review
# reminders. Point a scheduler at that route with an
# `Authorization: Bearer <this>` header. Leave blank and the route refuses
# every request — no reminders are sent, and nothing else is affected.
# At least 24 characters.
CRON_SECRET=""

# --- Seeding ----------------------------------------------------------------
# Accounts created by `npm run db:seed`. Change these before any deploy.
SEED_ADMIN_EMAIL="admin@techepitome.local"
SEED_ADMIN_PASSWORD="forge-admin-dev"
SEED_DEMO_EMAIL="demo@techepitome.local"
SEED_DEMO_PASSWORD="forge-demo-dev"
