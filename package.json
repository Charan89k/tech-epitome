{
  "name": "tech-epitome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "content:sync": "tsx scripts/chapter-content-sync.ts",
    "content:sync:dry": "tsx scripts/chapter-content-sync.ts --dry-run",
    "content:sync:prod": "NODE_ENV=production tsx scripts/chapter-content-sync.ts",
    "content:sync:prod:dry": "NODE_ENV=production tsx scripts/chapter-content-sync.ts --dry-run",
    "problems:verify": "tsx --conditions=react-server scripts/verify-problems.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:status:prod": "NODE_ENV=production prisma migrate status",
    "db:deploy:prod": "NODE_ENV=production prisma migrate deploy",
    "db:seed:prod": "NODE_ENV=production tsx prisma/seed.ts",
    "setup": "npm run db:up && npm run db:generate && npm run db:migrate && npm run db:seed",
    "postinstall": "prisma generate",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:e2e:prod": "next build && (npx next start --port 3200 & sleep 6; PROD_URL=http://127.0.0.1:3200 playwright test e2e/production-csp.spec.ts --project=chromium; kill %1)",
    "test:redis": "REDIS_TEST_SERVER=${REDIS_TEST_SERVER:-$(command -v redis-server)} REDIS_TEST_REQUIRED=true vitest run src/lib/rate-limit.redis.integration.test.ts",
    "capture:media": "playwright test --project=capture"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@monaco-editor/react": "^4.7.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "acorn": "^8.19.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.13.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "Tech Epitome - an interactive platform for learning DSA, system design, coding patterns and software engineering interviews.",
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
